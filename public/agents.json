{
  "$schema": "https://vaultsparkstudios.com/schemas/agents-v1.json",
  "project": "vaultfront",
  "name": "VaultFront",
  "vaultStatus": "FORGE",
  "releaseStatus": "public-unlaunched",
  "archetype": "game",
  "capabilities": [
    "browser-game",
    "multiplayer",
    "single-player",
    "replays",
    "verified-balance-envelope"
  ],
  "endpoints": {
    "landing": "https://vaultfront.io/",
    "docs": "https://vaultfront.io/docs/",
    "stats": "https://vaultfront.io/stats/",
    "statsMachine": "/stats.json",
    "contact": "mailto:founder@vaultsparkstudios.com?subject=VaultFront%20alpha%20interest",
    "source": "https://github.com/VaultSparkStudios/VaultFront",
    "capabilityManifest": "/capability-reachability.json",
    "balanceEnvelope": "/balance-envelope.json"
  },
  "availability": {
    "publicRuntime": "unavailable",
    "joinAlpha": "mailto:founder@vaultsparkstudios.com?subject=VaultFront%20alpha%20interest",
    "note": "No public gameplay origin is currently declared ready."
  },
  "agentInteractions": [
    {
      "method": "GET",
      "path": "/balance-envelope.json",
      "purpose": "Inspect deterministic convoy reward bounds, tuning lineage, and invariant counterexamples."
    },
    {
      "method": "GET",
      "path": "/stats.json",
      "purpose": "Inspect precomputed, period-labelled public game metrics and explicit pre-launch unavailability reasons."
    }
  ],
  "authentication": {
    "provider": "Obelisk",
    "status": "not-wired"
  },
  "rights": {
    "code": "GNU AGPL-3.0; see LICENSE and LICENSING.md",
    "branding": "VaultSpark-original branding, content, assets, and designs retain their applicable rights",
    "upstream": "OpenFrontIO; see CREDITS.md"
  },
  "studio": {
    "owner": "VaultSpark Studios LLC",
    "url": "https://vaultsparkstudios.com"
  }
}
