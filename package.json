{
  "name": "vaultfront",
  "engines": {
    "node": ">=22.13 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaultSparkStudios/VaultFront.git"
  },
  "homepage": "https://github.com/VaultSparkStudios/VaultFront",
  "bugs": {
    "url": "https://github.com/VaultSparkStudios/VaultFront/issues"
  },
  "scripts": {
    "build-dev": "concurrently \"tsc --noEmit\" \"vite build --mode development\"",
    "build-prod": "node scripts/generate-public-stats.mjs --check && tsc --noEmit && npm run balance:verify && vite build && node scripts/postbuild-pages.mjs && node scripts/generate-release-evidence.mjs",
    "build:pages": "node scripts/generate-public-stats.mjs --check && concurrently --kill-others-on-fail \"tsc --noEmit\" \"vite build\" && node scripts/postbuild-pages.mjs",
    "start:client": "vite",
    "start:server": "tsx src/server/Server.ts",
    "start:server-dev": "cross-env GAME_ENV=dev tsx src/server/Server.ts",
    "dev": "cross-env GAME_ENV=dev concurrently \"npm run start:client\" \"npm run start:server-dev\"",
    "dev:staging": "cross-env GAME_ENV=dev API_DOMAIN=api.openfront.dev concurrently \"npm run start:client\" \"npm run start:server-dev\"",
    "dev:prod": "cross-env GAME_ENV=dev API_DOMAIN=api.openfront.io concurrently \"npm run start:client\" \"npm run start:server-dev\"",
    "docs:map-generator": "cd map-generator && go doc -cmd -u -all",
    "tunnel": "npm run build-prod && npm run start:server",
    "test": "node scripts/run-vitest-shards.mjs",
    "test:server": "vitest run tests/server --maxWorkers=4",
    "verify:contracts": "node scripts/check-project-status-writers.mjs && node scripts/check-client-reachability.mjs && node scripts/check-runtime-feature-reachability.mjs && node scripts/check-route-policy-coverage.mjs && node scripts/check-worker-composition.mjs && node scripts/check-vaultfront-execution-composition.mjs && node scripts/check-deploy-contract.mjs && node scripts/check-release-input-trust.mjs && node scripts/check-hosted-cron-contract.mjs && node scripts/check-vaultfront-balance-authority.mjs && node scripts/check-win-modal-composition.mjs && node scripts/check-openapi-route-drift.mjs && node scripts/check-client-composition.mjs",
    "verify:pages": "node scripts/check-pages-deploy-contract.mjs --artifact static",
    "verify:stats": "node scripts/generate-public-stats.mjs --check && node ../vaultspark-studio-ops/scripts/check-stats-surface.mjs --project . --json",
    "generate:stats": "node scripts/generate-public-stats.mjs --write",
    "generate:public-shell": "node scripts/generate-public-shell.mjs --write",
    "perf": "npx tsx tests/perf/run-all.ts",
    "test:coverage": "vitest run --coverage --maxWorkers=4",
    "format": "prettier --ignore-unknown --write .",
    "format:map-generator": "cd map-generator && go fmt .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "husky",
    "gen-maps": "cd map-generator && go run . && npm run format",
    "inst": "npm ci --ignore-scripts",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "balance:verify": "tsx scripts/generate-balance-envelope.ts",
    "format:check": "node scripts/check-prettier-ratchet.mjs",
    "start:e2e-fixture": "node scripts/e2e-fixture-server.mjs",
    "start:e2e-client": "cross-env SKIP_BROWSER_OPEN=true DEV_API_ORIGIN=http://127.0.0.1:39081 DEV_LOBBY_ORIGIN=ws://127.0.0.1:39081 DEV_WORKER_ORIGIN=ws://127.0.0.1:39081 VITE_WORKER_INIT_TIMEOUT_MS=60000 vite --host 127.0.0.1",
    "preview:artifact": "vite preview --host 127.0.0.1 --port 4173"
  },
  "lint-staged": {
    "**/*": [
      "eslint --fix",
      "prettier --ignore-unknown --write"
    ]
  },
  "devDependencies": {
    "@datastructures-js/priority-queue": "6.3.5",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/benchmark": "2.1.5",
    "@types/chai": "4.3.20",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/d3": "7.4.3",
    "@types/express": "4.17.23",
    "@types/google-protobuf": "3.15.12",
    "@types/hammerjs": "2.0.46",
    "@types/howler": "2.2.13",
    "@types/jquery": "3.5.32",
    "@types/js-yaml": "4.0.9",
    "@types/msgpack5": "3.4.7",
    "@types/node": "22.15.32",
    "@types/pg": "8.20.0",
    "@types/seedrandom": "3.0.8",
    "@types/sinon": "17.0.4",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "autoprefixer": "10.5.4",
    "benchmark": "2.1.4",
    "canvas": "3.2.3",
    "chai": "5.2.0",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "d3": "7.9.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-formatter-gha": "1.5.2",
    "glob": "13.0.6",
    "globals": "16.2.0",
    "husky": "9.1.7",
    "jsdom": "27.4.0",
    "lint-staged": "16.1.2",
    "lit": "3.3.3",
    "lit-markdown": "1.3.2",
    "mrmime": "2.0.1",
    "pixi-filters": "6.1.5",
    "pixi.js": "8.19.0",
    "prettier": "3.9.5",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-sh": "0.19.0",
    "protobufjs": "7.6.5",
    "sinon": "21.0.1",
    "sinon-chai": "4.0.1",
    "tailwindcss": "4.3.3",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.2.1",
    "vite-plugin-static-copy": "3.1.4",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10",
    "vitest-canvas-mock": "1.1.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.220.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@opentelemetry/winston-transport": "0.30.0",
    "colord": "2.9.3",
    "colorjs.io": "0.7.0",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dompurify": "3.4.13",
    "dotenv": "16.5.0",
    "ejs": "6.0.1",
    "express": "4.22.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.3.0",
    "howler": "2.2.4",
    "intl-messageformat": "10.7.16",
    "ip-anonymize": "0.1.0",
    "jose": "6.2.3",
    "nanoid": "3.3.18",
    "node-html-parser": "7.0.2",
    "obscenity": "0.4.6",
    "pg": "8.22.0",
    "seedrandom": "3.0.5",
    "tsx": "4.23.1",
    "uuid": "11.1.1",
    "winston": "3.19.0",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "type": "module",
  "overrides": {
    "brace-expansion": "5.0.9",
    "tar": "7.5.22",
    "ejs": "$ejs"
  },
  "private": true
}
